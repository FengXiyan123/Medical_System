MYSQL_DATABASE=medical_system
MYSQL_USER=medical_app
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
POSTGRES_DB=medical_vector
POSTGRES_USER=medical_vector_app
POSTGRES_PASSWORD=change-me-vector
REDIS_PORT=6379
# Leave blank when Redis has no password; set it when the container uses --requirepass.
REDIS_PASSWORD=
GATEWAY_PORT=8080
AGENT_CORE_PORT=8000
WEB_PORT=5173
MODEL_MODE=mock
# Optional. Use the legacy Beijing compatible endpoint only if the workspace-specific endpoint is unavailable.
DASHSCOPE_BASE_URL=
GATEWAY_ACCESS_TOKEN_SECRET=replace-with-a-unique-32-byte-minimum-secret
GATEWAY_SERVICE_TOKEN_SECRET=replace-with-a-different-32-byte-minimum-secret
DEMO_BOOTSTRAP_ENABLED=true
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=user
